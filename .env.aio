# AIO (all-in-one) local environment overrides for running on a single VPS
# Intended for local/dev; keep this separate from production .env

FILE_SIZE_LIMIT=50MB
BUCKET_NAME=plane-bucket
CERT_EMAIL=
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=
TRUSTED_PROXIES=127.0.0.1/32
# Caddy AIO site binding is set in Caddyfile.aio.ce to 127.0.0.1:2015
SITE_ADDRESS=127.0.0.1:2015

# Note: In this setup nginx on the VPS should terminate TLS for app.c36space.com
# and proxy to Caddy on 127.0.0.1:2015. Do NOT expose backend ports publicly.
