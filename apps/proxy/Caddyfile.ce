{
  auto_https off
}

:80 {
  encode gzip

  @api path /api/* /auth/* /admin-api/*
  reverse_proxy @api api:8000

  @live path /live/*
  reverse_proxy @live live:3003

  @space path /spaces/*
  reverse_proxy @space space:3000

  @admin path /admin/*
  reverse_proxy @admin admin:3000

  reverse_proxy web:3000
}