(plane_proxy) {

    request_body {
        max_size {$FILE_SIZE_LIMIT}
    }

    # --------------------
    # ADMIN (MUST BE FIRST)
    # --------------------
    redir /god-mode /god-mode/ permanent
    handle /god-mode/* {
        root * /app/admin
        try_files {path} {path}/ /god-mode/index.html
        file_server
    }

    # Spaces
    redir /spaces /spaces/ permanent
    handle /spaces/* {
        reverse_proxy space:3000
    }

    # Live
    handle /live/* {
        reverse_proxy live:3000
    }

    # API / Auth
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /auth/* {
        reverse_proxy api:8000
    }

    # Backend static
    handle /static/* {
        reverse_proxy api:8000
    }

    # MinIO
    handle /{$BUCKET_NAME}/* {
        reverse_proxy plane-minio:9000
    }
    handle /{$BUCKET_NAME} {
        reverse_proxy plane-minio:9000
    }

    # Web assets
    handle /assets/* {
        root * /app/web
        file_server
    }

    # Web SPA (LAST — catch-all)
    handle {
        root * /app/web
        try_files {path} {path}/ /index.html
        file_server
    }
}


