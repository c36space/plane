{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

(plane_proxy) {
	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

	# Spaces
	redir /spaces /spaces/ permanent
	handle /spaces/* {
		reverse_proxy space:3000
	}

	# Admin
	redir /god-mode /god-mode/ permanent
	handle_path /god-mode/* {
		root * /app/admin
		try_files {path} /index.html
		file_server
	}

	# Live
	handle /live/* {
		reverse_proxy live:3000
	}

	# API / Auth
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /auth/* {
		reverse_proxy api:8000
	}

	# Static backend assets
	handle /static/* {
		reverse_proxy api:8000
	}

	# MinIO bucket
	handle /{$BUCKET_NAME}/* {
		reverse_proxy plane-minio:9000
	}
	handle /{$BUCKET_NAME} {
		reverse_proxy plane-minio:9000
	}

	# Web SPA (MUST be last)
	handle {
		root * /app/web
		try_files {path} /index.html
		file_server
	}
}

{$SITE_ADDRESS} {
	import plane_proxy
}
