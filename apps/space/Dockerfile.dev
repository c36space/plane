FROM node:22-alpine

# Install build dependencies for Alpine
RUN apk add --no-cache python3 make g++ git curl bash

# Set pnpm environment variables
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

# Enable corepack and pnpm
RUN corepack enable && \
    corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy package files first for better caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/space/package.json ./apps/space/
COPY packages/ ./packages/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy the rest of the application
COPY apps/space ./apps/space

# Set environment variable for Space
ENV VITE_SPACE_BASE_PATH="/spaces"

EXPOSE 3002

CMD ["pnpm", "dev", "--filter=space"]